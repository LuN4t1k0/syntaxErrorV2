{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "pnpm --filter @syntaxerror/content validate && next build",
    "start": "next start",
    "test": "vitest run",
    "db:seed": "tsx src/db/seed-cli.ts",
    "release": "tsx src/db/release-cli.ts",
    "release:build": "esbuild src/db/release-cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/release.mjs --log-level=warning --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.0",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^10.75.3",
    "@syntaxerror/content": "workspace:*",
    "@syntaxerror/db": "workspace:*",
    "@syntaxerror/engines": "workspace:*",
    "@syntaxerror/ia": "workspace:*",
    "@syntaxerror/queue": "workspace:*",
    "@syntaxerror/ui": "workspace:*",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.36.0",
    "ioredis": "5.10.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "next-auth": "5.0.0-beta.31",
    "next-themes": "^0.4.4",
    "rate-limiter-flexible": "^11.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.4",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  }
}
